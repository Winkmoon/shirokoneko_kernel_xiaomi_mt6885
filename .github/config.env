USE_CONFIG=false

# ===== Kernel =====
KERNEL_DEFCONFIG=vendor/cezanne_user_defconfig
KERNEL_FILE=Image.gz-dtb

# ===== Clang / 额外编译参数 =====
# 注意这里按 workflow 的解析，用冒号(:)分隔；留空就什么都不加
EXTRA_BUILD_COMMAND:

# ===== KernelSU flags =====
USE_KERNELSU=true
KERNELSU_TAG=main

# ===== SukiSU-Ultra 集成开关 =====
# 用 SukiSU-Ultra 替代 KernelSU
USE_SUKISU=true
# 集成模式：main（GKI）/ nongki（非GKI）/ susfs-<branch>（如 susfs-main、susfs-1.5.7）
SUKISU_MODE=nongki

# ===== 构建 boot.img =====
MAKE_BOOT_IMAGE=true
SOURCE_BOOT_IMAGE=https://github.com/btree2/android_kernel_xiaomi_mt6885/raw/refs/heads/cgroup-v2/.github/boot.img
